# =============================================================================
# personal-gpt - 环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env：       cp .env.example .env
#   2. 填入你自己的真实凭据（.env 已在 .gitignore 中，不会被提交）
#   3. 切勿将含有真实 token 的 .env 提交到任何远程仓库
# =============================================================================


# ----- Astra DB（向量数据库） -----
# 从 Astra Portal → 你的数据库 → Connect 页签 获取以下信息
# https://astra.datastax.com/

# Keyspace 名称（一般保持 default_keyspace 即可）
ASTRA_DB_NAMESPACE=default_keyspace

# 当前项目使用的集合（collection）名；须与 NVIDIA NIM 2048 维 embedding 一致
ASTRA_DB_COLLECTION=db_emotion

# Data API endpoint（形如 https://<db-id>-<region>.apps.astra.datastax.com）
ASTRA_DB_API_ENDPOINT=https://<your-db-id>-<region>.apps.astra.datastax.com

# Application token（必须包含 r/w 权限；以 AstraCS: 开头）
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token-here>


# ----- Groq（聊天主模型 + RAG 辅助，免费层无需绑卡） -----
# 从 https://console.groq.com/keys 获取（gsk_ 开头）
# @ai-sdk/groq / openai-compatible 读取 GROQ_API_KEY
GROQ_API_KEY=<your-groq-api-key-here>


# ----- Google AI（可选；国内地区 API 不可用，RAG 辅助已改 Groq） -----
# GOOGLE_GENERATIVE_AI_API_KEY=<your-google-api-key-here>
# 从 https://build.nvidia.com 获取 API Key（nvapi- 开头）
NIM_API_KEY=<your-nim-api-key-here>


# ----- 性能调优（可选；不设则用代码内默认值） -----

# 向量检索总超时（毫秒）。默认 12000；HyDE/Multi-Query/Reranker 全开时建议 45000。
# 超时后另有 10s 宽限期（RETRIEVAL_GRACE_MS，代码内固定）。
# VECTOR_SEARCH_TIMEOUT_MS=12000

# embedding LRU 缓存容量。默认 100。
# 4 个固定 prompt-suggestion 按钮 + 用户重复提问的余量，100 足够。
# EMBEDDING_CACHE_SIZE=100

# 模糊问法由 LLM 判断 direct（直答）或 retrieve（检索）。默认 true
# ENABLE_LLM_QUERY_ROUTER=true

# 路由前 embedding Top-1 预检。默认 true
# ENABLE_EMBEDDING_ROUTE_PRECHECK=true
# ROUTE_RETRIEVE_SIMILARITY=0.68
# ROUTE_DIRECT_SIMILARITY=0.42

# RAG 检索增强（默认关闭，按需开启）
# ENABLE_HYDE=true
# ENABLE_MULTI_QUERY=true
# ENABLE_RERANKER=true


# ----- Upstash Redis（限流，可选；不配则限流禁用 = fail-open） -----
# 用于 /api/chat 按 IP 限流（10 req / 60s 滑动窗口）。
# 推荐通过 Vercel Marketplace → Storage → Upstash for Redis 集成添加，
# 会自动把以下两个变量注入到 Vercel 环境（Production + Preview + Development）。
# 本地开发：可不配（限流自动禁用），或 `vercel env pull` 拉到 .env.local。
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>


# ----- 本地开发基础设施（Docker Compose） -----
# 启动：yarn docker:up
# 凭据与 docker-compose.yml 中 postgres / redis 服务对齐

DATABASE_URL=postgresql://personal_gpt:personal_gpt@localhost:5432/personal_gpt
REDIS_URL=redis://localhost:6379


# ----- LangSmith 追踪（可选；ENG-01，无 key 时自动关闭） -----
# 从 https://smith.langchain.com/ 获取 API Key
# LANGSMITH_API_KEY=lsv2_pt_<your-key-here>
# LANGSMITH_PROJECT=personal-gpt-v1.0
# LANGSMITH_TRACING=true


# ----- Agent Service（v1.0 透传骨架，可选） -----
# WEB_URL=http://localhost:3000
# AGENT_SERVICE_PORT=3002
