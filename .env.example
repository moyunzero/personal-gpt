# =============================================================================
# personal-gpt - 环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env：       cp .env.example .env
#   2. 填入你自己的真实凭据（.env 已在 .gitignore 中，不会被提交）
#   3. 切勿将含有真实 token 的 .env 提交到任何远程仓库
# =============================================================================


# ----- Astra DB（向量数据库） -----
# 从 Astra Portal → 你的数据库 → Connect 页签 获取以下信息
# https://astra.datastax.com/

# Keyspace 名称（一般保持 default_keyspace 即可）
ASTRA_DB_NAMESPACE=default_keyspace

# 当前项目使用的集合（collection）名；须与 NVIDIA NIM 2048 维 embedding 一致
ASTRA_DB_COLLECTION=db_emotion

# Data API endpoint（形如 https://<db-id>-<region>.apps.astra.datastax.com）
ASTRA_DB_API_ENDPOINT=https://<your-db-id>-<region>.apps.astra.datastax.com

# Application token（必须包含 r/w 权限；以 AstraCS: 开头）
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token-here>


# ----- Groq（聊天主模型 + RAG 辅助，免费层无需绑卡） -----
# 从 https://console.groq.com/keys 获取（gsk_ 开头）
# @ai-sdk/groq / openai-compatible 读取 GROQ_API_KEY
GROQ_API_KEY=<your-groq-api-key-here>

# ----- Cerebras（Agent 可选；OpenAI 兼容，日额度通常更大） -----
# 从 https://cloud.cerebras.ai 获取
# CEREBRAS_API_KEY=<your-cerebras-api-key-here>
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# AGENT_PROVIDER=cerebras
# AGENT_MODEL=gpt-oss-120b


# ----- Google AI（可选；国内地区 API 不可用，RAG 辅助已改 Groq） -----
# GOOGLE_GENERATIVE_AI_API_KEY=<your-google-api-key-here>
# 从 https://build.nvidia.com 获取 API Key（nvapi- 开头）
NIM_API_KEY=<your-nim-api-key-here>


# ----- 性能调优（可选；不设则用代码内默认值） -----

# 向量检索总超时（毫秒）。默认 12000，上限 60000；HyDE/Multi-Query/Reranker 全开时建议 45000。
# 超时后另有 10s 宽限期（RETRIEVAL_GRACE_MS，代码内固定）。
# VECTOR_SEARCH_TIMEOUT_MS=12000

# embedding LRU 缓存容量。默认 100。
# 4 个固定 prompt-suggestion 按钮 + 用户重复提问的余量，100 足够。
# EMBEDDING_CACHE_SIZE=100

# 模糊问法由 LLM 判断 direct（直答）或 retrieve（检索）。默认 true
# ENABLE_LLM_QUERY_ROUTER=true

# 路由前 embedding Top-1 预检。默认 true
# ENABLE_EMBEDDING_ROUTE_PRECHECK=true
# ROUTE_RETRIEVE_SIMILARITY=0.68
# ROUTE_DIRECT_SIMILARITY=0.42

# RAG 检索增强（默认关闭，按需开启）
# ENABLE_HYDE=true
# ENABLE_MULTI_QUERY=true
# ENABLE_RERANKER=true


# ----- Upstash Redis（限流，可选；不配则限流禁用 = fail-open） -----
# 用于 /api/chat 按 IP 限流（10 req / 60s 滑动窗口）。
# 推荐通过 Vercel Marketplace → Storage → Upstash for Redis 集成添加，
# 会自动把以下两个变量注入到 Vercel 环境（Production + Preview + Development）。
# 本地开发：可不配（限流自动禁用），或 `vercel env pull` 拉到 .env.local。
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>


# ----- 本地开发基础设施（Docker Compose） -----
# 启动：yarn docker:up
# 凭据与 docker-compose.yml 中 postgres / redis 服务对齐

DATABASE_URL=postgresql://personal_gpt:personal_gpt@localhost:5432/personal_gpt
REDIS_URL=redis://localhost:6379


# ----- LangSmith 追踪（可选；ENG-01，无 key 时自动关闭） -----
# 从 https://smith.langchain.com/ 获取 API Key
# LANGSMITH_API_KEY=lsv2_pt_<your-key-here>
# Chat 模式可用 personal-gpt-v1.0；Agent 流量建议 personal-gpt-agent（D-18）
# LANGSMITH_PROJECT=personal-gpt-agent
# LANGSMITH_TRACING=true


# ----- Agent Service（Phase 2 LangGraph；可选） -----
# WEB_URL=http://localhost:3000
# AGENT_SERVICE_PORT=3002
# 浏览器经 Next BFF `/api/agent/chat` 转发；服务端上游基址：
# AGENT_SERVICE_URL=http://localhost:3002
# v2.x 临时护栏：设置后 agent-service 要求 Authorization: Bearer <token>（BFF 自动注入）
# 生产 / 公网部署：必须设置非空 AGENT_INTERNAL_TOKEN，或确保 agent-service 仅私网入口可达；
# 本地演示可不设（token 校验跳过）。正式身份体系见 v4。
# AGENT_INTERNAL_TOKEN=<shared-secret-web-to-agent>
# INTERNAL_PROXY_KEY=<shared-secret-for-agent-service-to-web>
# agent-service CORS 允许源（逗号分隔；默认 http://localhost:3000；勿 credentials+裸 *）
# CORS_ORIGIN=http://localhost:3000
# 遗留：直连 agent 时的客户端基址（v2.x 默认走 BFF，一般可不设）
# NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:3002
# LangGraph recursionLimit 硬护栏（D-15）；默认 40
# AGENT_RECURSION_LIMIT=40
# 知识库有效命中最低相似度（低于则 NO_RELEVANT_HIT；默认 0.68）
# AGENT_KB_MIN_SIMILARITY=0.68
# Checkpointer：memory（进程单例，同进程 thread_id 可续）| sqlite（落盘会话）
# AGENT_CHECKPOINTER=memory
# AGENT_CHECKPOINTER_SQLITE_PATH=.data/agent-checkpoints.sqlite
# Skills 开关，逗号分隔；默认 kb-retrieval,web-research,report-writer
# ENABLED_SKILLS=kb-retrieval,web-research,report-writer
# Bocha 联网搜索（可选；未配则 Researcher 降级，D-14）
# BOCHA_API_KEY=<your-bocha-api-key>


# ----- 安全（生产部署建议开启） -----
# 设 KB_ADMIN_TOKEN 后 /api/kb/* 需 Authorization: Bearer <token>
# KB_ADMIN_TOKEN=<your-kb-admin-token>

# ----- 入库指标压测 yarn bench:ingest（可选） -----
# BENCH_BASE_URL=http://localhost:3000
# BENCH_SMALL_N=10
# BENCH_INCLUDE_CORRUPT=1
# BENCH_CLEANUP=1
# BENCH_EMBED_USD_PER_1M=   # 每百万 token 单价，用于估算 USD；不设则只出 chunk/浪费比例

# v0.1 无 workspaceId 的 Astra chunk 回退检索；默认关闭
# ASTRA_LEGACY_FALLBACK=true
