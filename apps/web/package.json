{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env next dev",
    "build": "yarn workspace @personal-gpt/shared build && node script/run-kb-migrations.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "yarn type-check && yarn test && yarn build",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d lib/db/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d lib/db/data-source.ts",
    "migrate:kb": "node script/run-kb-migrations.mjs",
    "migrate:legacy": "ts-node --project tsconfig.json script/migrateLegacy.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.179",
    "@auth/typeorm-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "3.787.0",
    "@datastax/astra-db-ts": "2.2.1",
    "@personal-gpt/shared": "*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2",
    "ai": "6.0.177",
    "bullmq": "5.56.0",
    "ioredis": "5.11.1",
    "langsmith": "0.7.15",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "pg": "8.22.0",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "typeorm": "0.3.28",
    "undici": "^6.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@langchain/community": "1.1.28",
    "@langchain/core": "1.1.45",
    "@nestjs/typeorm": "11.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.59.1",
    "tailwindcss": "^4",
    "ts-node": "10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
