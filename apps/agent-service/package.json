{
  "name": "agent-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "yarn workspace @personal-gpt/shared build && nest build",
    "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config dist/main.js",
    "start:dev": "yarn workspace @personal-gpt/shared build && DOTENV_CONFIG_PATH=../../.env nest start --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "validate": "yarn type-check && yarn build"
  },
  "dependencies": {
    "@ai-sdk/langchain": "2.0.152",
    "@langchain/core": "1.2.5",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint": "1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.3",
    "@langchain/langgraph-supervisor": "1.1.1",
    "@langchain/openai": "1.5.6",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@personal-gpt/shared": "*",
    "ai": "6.0.177",
    "dotenv": "17.4.2",
    "langchain": "1.5.5",
    "langsmith": "0.7.15",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^6.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
