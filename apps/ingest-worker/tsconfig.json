{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@personal-gpt/shared/types/kb": ["../../packages/shared/src/types/kb.ts"],
      "@personal-gpt/shared/*": ["../../packages/shared/src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "../web/lib/db/entities/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
