{
  "name": "ingest-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config dist/apps/ingest-worker/src/main.js",
    "start:dev": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config src/main.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify:parse": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config --project tsconfig.json script/verify-parse.ts",
    "validate": "yarn type-check && yarn test && yarn build"
  },
  "dependencies": {
    "@langchain/textsplitters": "1.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/typeorm": "11.0.3",
    "@personal-gpt/shared": "*",
    "@vercel/blob": "^2",
    "bullmq": "5.56.0",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "langsmith": "0.7.15",
    "mammoth": "1.12.0",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "ts-node": "10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
