{
  "name": "@personal-gpt/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types/kb": {
      "types": "./src/types/kb.ts",
      "default": "./dist/types/kb.js"
    },
    "./types/agent": {
      "types": "./src/types/agent.ts",
      "default": "./dist/types/agent.js"
    },
    "./schemas/env": {
      "types": "./src/schemas/env.ts",
      "default": "./dist/schemas/env.js"
    },
    "./utils/ingest": {
      "types": "./src/utils/ingest.ts",
      "default": "./dist/utils/ingest.js"
    },
    "./utils/paths": {
      "types": "./src/utils/paths.ts",
      "default": "./dist/utils/paths.js"
    },
    "./constants/workspace": {
      "types": "./src/constants/workspace.ts",
      "default": "./dist/constants/workspace.js"
    },
    "./constants/queue": {
      "types": "./src/constants/queue.ts",
      "default": "./dist/constants/queue.js"
    },
    "./stores/vector-store": {
      "types": "./src/stores/vector-store.ts",
      "default": "./dist/stores/vector-store.js"
    },
    "./stores/vector-store.astra": {
      "types": "./src/stores/vector-store.astra.ts",
      "default": "./dist/stores/vector-store.astra.js"
    },
    "./stores/vector-store.milvus": {
      "types": "./src/stores/vector-store.milvus.ts",
      "default": "./dist/stores/vector-store.milvus.js"
    },
    "./stores/vector-store.factory": {
      "types": "./src/stores/vector-store.factory.ts",
      "default": "./dist/stores/vector-store.factory.js"
    },
    "./ai/groq-models": {
      "types": "./src/ai/groq-models.ts",
      "default": "./dist/ai/groq-models.js"
    },
    "./ai/groq-chat": {
      "types": "./src/ai/groq-chat.ts",
      "default": "./dist/ai/groq-chat.js"
    },
    "./ai/chat-provider": {
      "types": "./src/ai/chat-provider.ts",
      "default": "./dist/ai/chat-provider.js"
    },
    "./ai/embedding-models": {
      "types": "./src/ai/embedding-models.ts",
      "default": "./dist/ai/embedding-models.js"
    },
    "./ai/embeddings": {
      "types": "./src/ai/embeddings.ts",
      "default": "./dist/ai/embeddings.js"
    },
    "./ai/rag-helper": {
      "types": "./src/ai/rag-helper.ts",
      "default": "./dist/ai/rag-helper.js"
    },
    "./routing": {
      "types": "./src/routing/index.ts",
      "default": "./dist/routing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "validate": "yarn type-check && yarn test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.56",
    "@datastax/astra-db-ts": "2.2.1",
    "@elastic/elasticsearch": "8.17.1",
    "@zilliz/milvus2-sdk-node": "3.0.4",
    "ai": "6.0.177",
    "ioredis": "5.11.1",
    "mem0ai": "3.1.6",
    "neo4j-driver": "6.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
