{
  "name": "personal-gpt",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace web dev",
    "dev:worker": "yarn workspace ingest-worker start:dev",
    "dev:agent": "yarn workspace agent-service start:dev",
    "docker:up": "docker compose up -d",
    "seed": "ts-node --project tsconfig.scripts.json ./script/loadDB.ts",
    "seed:psychology": "ts-node --project tsconfig.scripts.json ./script/loadPsychologyData.ts",
    "seed:suggestions": "ts-node --project tsconfig.scripts.json ./script/loadPromptSuggestions.ts",
    "astra:init-embedding": "ts-node --project tsconfig.scripts.json ./script/initEmbeddingCollection.ts",
    "bench:ingest": "ts-node --project tsconfig.scripts.json ./script/bench-ingest-metrics.ts",
    "migrate:legacy": "yarn workspace web migrate:legacy",
    "lint": "eslint packages apps/ingest-worker apps/agent-service script tests && yarn workspace web lint",
    "lint:fix": "eslint packages apps/ingest-worker apps/agent-service script tests --fix && yarn workspace web lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepush": "yarn format:check && yarn lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "node ./script/install-git-hooks.mjs",
    "validate": "yarn format:check && yarn lint && yarn workspace web validate && yarn workspace ingest-worker validate && yarn workspace agent-service validate && yarn workspace @personal-gpt/shared validate",
    "test": "vitest run",
    "test:regression": "vitest run tests/regression/phase-1 tests/regression/phase-2",
    "test:regression:phase-1": "vitest run tests/regression/phase-1",
    "test:regression:phase-2": "vitest run tests/regression/phase-2",
    "acceptance:phase-1": "node tests/acceptance/phase-1/run.mjs && prettier --write tests/acceptance/phase-1/RESULT.json",
    "acceptance:phase-2-smoke": "node tests/acceptance/phase-2-agent/smoke-sse.mjs && prettier --write tests/acceptance/phase-2-agent/SMOKE-RESULT.json tests/acceptance/phase-2-agent/checks-kb-hit.json",
    "vercel-build": "yarn workspace web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@datastax/astra-db-ts": "2.2.1",
    "@langchain/community": "1.1.28",
    "@langchain/core": "1.1.45",
    "@langchain/textsplitters": "1.0.1",
    "@personal-gpt/shared": "*",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "openai": "6.37.0",
    "prettier": "^3.6.2",
    "playwright": "1.59.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.6"
  }
}
