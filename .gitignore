# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# acceptance / 本地人工与 live smoke 产物（不入库、不推 GitHub）
tests/acceptance/**/*.png
tests/acceptance/**/*.html
tests/acceptance/**/*.log
tests/acceptance/**/*-stream.txt
tests/acceptance/**/*RESULT*.json
tests/acceptance/**/*RESULT*.md
tests/acceptance/**/checks*.json
tests/acceptance/**/trace-obs*
tests/acceptance/**/SMOKE-RESULT*.json
tests/acceptance/**/fixtures/
tests/acceptance/**/screenshots/
tests/acceptance/**/run.mjs
tests/acceptance/**/run-*.mjs
tests/acceptance/**/smoke-*.mjs
tests/acceptance/**/run-*.py
tests/acceptance/**/run*.py
tests/acceptance/**/*-probe.json
tests/acceptance/**/*export.md
tests/acceptance/**/*export.json
tests/acceptance/**/*RETEST*.md
tests/acceptance/**/*FIX-ACCEPTANCE*.md
# 保留验收说明文档（截图/stream/报告仍走 .gitignore，不入库）
!tests/acceptance/**/README.md
!tests/acceptance/**/CLOSEOUT.md
!tests/acceptance/**/ACCEPTANCE.md
!tests/acceptance/**/MCP-ACCEPTANCE.md

# next.js
/.next/
/apps/web/.next/
/out/

# production
/build
/apps/ingest-worker/dist
/apps/agent-service/dist
/packages/shared/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cursor MCP（含 Astra 等本地凭据，勿提交）
.cursor/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.kiro/

data/
uploads/
.data/

.planning/
.env*.local

# 本地产品与开发文档（与 .planning/ 同级，不入库、不推 GitHub）
docs/

# 本地 Phase 复盘博客（不入库）
blog/

reference/

.agents/

# ingest bench outputs (local metrics runs)
script/bench-output/

# CodeGraph local index (machine-specific)
.codegraph/*
!.codegraph/.gitignore